#!/bin/sh
# AGENTS.md §6 — main is PR-only.
# Refuses any push that would update refs/heads/main on the remote.
#
# Install (see scripts/install-git-hooks.sh — it copies this file into .git/hooks/):
#     scripts/install-git-hooks.sh
#     git config --unset core.hooksPath      # a relative hooksPath silently does nothing
# Prefer an ABSOLUTE path if you drive it via core.hooksPath:
#     git config core.hooksPath "$(git rev-parse --show-toplevel)/.githooks"
# Maintainer escape hatch:
#     OSRA_ALLOW_MAIN_PUSH=1 git push <remote> main
#
# Why this file exists at all: GitHub branch protection is unavailable on private repos on the
# free plan (403 "Upgrade to GitHub Pro or make this repository public"), so the rule is enforced
# locally here and detected server-side by .github/workflows/main-guard.yml.
# NOTE: this file must be present in the checked-out ref; on `main` it only exists after this
# guard is merged, which is why .git/hooks/ is the reliable location.
if [ "${OSRA_ALLOW_MAIN_PUSH}" = "1" ]; then
  exit 0
fi

# Workflow schema check (issue #37): a workflow file GitHub rejects means ZERO jobs run — CI goes
# silent while looking "configured". PyYAML accepts what GitHub refuses, so this is checked here.
root=$(git rev-parse --show-toplevel 2>/dev/null || echo .)
if command -v node >/dev/null 2>&1 && [ -f "$root/scripts/check-workflows.mjs" ]; then
  if ! node "$root/scripts/check-workflows.mjs" --strict >/tmp/osra-wf-check.log 2>&1; then
    cat >&2 <<'MSG'
BLOCKED: .github/workflows failed the schema check — GitHub would reject the file and skip
         every job, leaving CI silently dead (this is exactly how issue #37 happened).

  Run it yourself to see the details:
      node scripts/check-workflows.mjs --strict
MSG
    cat /tmp/osra-wf-check.log >&2
    exit 1
  fi
fi

# Documentation links: keeps the doc index navigable (cheap, ~0.5 s).
if command -v node >/dev/null 2>&1 && [ -f "$root/scripts/check-docs-links.mjs" ]; then
  if ! node "$root/scripts/check-docs-links.mjs" --quiet >/tmp/osra-doc-check.log 2>&1; then
    echo "BLOCKED: broken documentation link(s) — run: node scripts/check-docs-links.mjs" >&2
    cat /tmp/osra-doc-check.log >&2
    exit 1
  fi
fi

blocked=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main)
      blocked=1
      ;;
  esac
done

if [ "$blocked" = "1" ]; then
  cat >&2 <<'MSG'
BLOCKED: direct push to main is disabled (AGENTS.md §6 — main is PR-only).

  Push your work on a branch and open a pull request instead:
      git push origin HEAD
  then open the PR with the template and request review from the other agent.

  Maintainer override (deliberate, rare):
      OSRA_ALLOW_MAIN_PUSH=1 git push <remote> main
MSG
  exit 1
fi

exit 0
