# ── Secrets ──────────────────────────────────────────────────────────────────
# Real .env files never belong in git; committed examples (*.env.example) are fine.
.env
.env.*
!*.env.example
!**/.env.example
**/agent.config.json

# ── Test distribution bundles (binaries + launcher secrets live only locally) ─
dist/

