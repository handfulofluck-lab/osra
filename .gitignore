# ── Secrets ──────────────────────────────────────────────────────────────────
# Real .env files never belong in git; committed examples (*.env.example) are fine.
.env
.env.*
!*.env.example
!**/.env.example
**/agent.config.json

# ── Test distribution bundles (binaries + launcher secrets live only locally) ─
dist/

# ── Node / pnpm ──────────────────────────────────────────────────────────────
node_modules/
.turbo/
*.tsbuildinfo
npm-debug.log*
pnpm-debug.log*

# ── Build outputs ────────────────────────────────────────────────────────────
**/dist/

# Flutter / Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
**/android/.gradle/
**/local.properties
*.iml

# Android / Gradle
**/.gradle/
**/build/
.cxx/
*.apk
*.aab
*.keystore

# .NET
bin/
obj/
pub/
*.user

# Python
__pycache__/
# Plan 4.1: the hosted scorer's disk cache (paid results, keyed by content hash).
services/ai-engine/eval/.deepseek-cache.json
services/ai-engine/deepseek-result.json
*.py[cod]
.venv/
.pytest_cache/
*.egg-info/

