    <!-- OnboardingPolicy: the ten rows of the setup checklist. The names match the parent app's
         `grantAccessibility` … `grantNotificationListener`, so both phones name a permission the same way. -->
    <string name="onboarding_grant_accessibility_title">Accessibility service</string>
    <string name="onboarding_grant_accessibility_why">Blocks apps, enforces limits and guards the uninstall screens. Nothing works without it.</string>
    <string name="onboarding_grant_usage_title">Usage access</string>
    <string name="onboarding_grant_usage_why">Counts screen time per app so daily limits and reports are right.</string>
    <string name="onboarding_grant_overlay_title">Display over other apps</string>
    <string name="onboarding_grant_overlay_why">Shows the lock, pause and PIN screens on top of whatever is open.</string>
    <string name="onboarding_grant_device_admin_title">Device admin</string>
    <string name="onboarding_grant_device_admin_why">Stops the app being uninstalled without the parent PIN; lets the parent lock the device.</string>
    <string name="onboarding_grant_web_filter_title">Web filter (VPN consent)</string>
    <string name="onboarding_grant_web_filter_why">Blocks sites and categories, forces SafeSearch, and makes pause-internet real.</string>
    <string name="onboarding_grant_location_title">Location (allow all the time)</string>
    <string name="onboarding_grant_location_why">Locate the device and geofence alerts; background access keeps it working with the app closed.</string>
    <string name="onboarding_grant_private_dns_title">Private DNS not set to a provider</string>
    <string name="onboarding_grant_private_dns_why">A named Private DNS provider bypasses the web filter. Set it to Automatic or Off.</string>
    <string name="onboarding_grant_battery_title">Battery: unrestricted</string>
    <string name="onboarding_grant_battery_why">Without it the phone may pause the agent in the background and commands arrive late.</string>
    <string name="onboarding_grant_usb_title">USB debugging off</string>
    <!-- The sweep drops "(Phase 2.6)" from this line: an internal plan number a parent should not read. -->
    <string name="onboarding_grant_usb_why">With USB debugging on, anyone with a computer can clear OSRA\'s data on this phone. Turn it off in Developer options.</string>
    <string name="onboarding_grant_notification_title">Notification access</string>
    <string name="onboarding_grant_notification_why">Reads notifications from monitored apps for the safety scan.</string>

