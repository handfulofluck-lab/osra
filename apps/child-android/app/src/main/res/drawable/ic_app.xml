<?xml version="1.0" encoding="utf-8"?>
<!-- Application icon (issue #217): the system permission and device-admin sheets show this next to the label,
     and the launcher shows it on the home screen. It is the OSRA logo, "Embrace" (docs/design/BRAND.md,
     roadmap 3.20), as an adaptive icon (minSdk is 26). The three colours are resources so the Full flavour
     can carry its own (src/full/res/values/ic_app_colors.xml): OSRA Kids is light, OSRA Kids Full is dark. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_app_background"/>
    <foreground android:drawable="@drawable/ic_app_foreground"/>
</adaptive-icon>
