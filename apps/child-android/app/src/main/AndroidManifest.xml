<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      ADR-0021: package visibility is declared narrowly instead of QUERY_ALL_PACKAGES (which Play does
      not list parental control for). The two dialer intents are load-bearing: AndroidPackageFacts resolves
      the emergency/DIAL handlers to keep the lock off the dialer (#83, S1). The HOME intent is
      load-bearing for #165: it is how the block overlay learns the launcher's package on an OEM the
      static table does not name. Remove any of them and a safety exemption silently weakens on the
      store build.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Issue #165: the current HOME handler is exempt from the block overlay by role, because an
             OEM launcher's package name is not knowable in advance (AndroidPackageFacts.homePackages). -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <intent>
            <action android:name="com.android.phone.EmergencyDialer.DIAL" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
    </queries>
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"/>
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <!-- Needed on API 33+ for the foreground location notification to be shown. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!--
      Roadmap 3.2: the child scans the parent's pairing QR code. Camera is a user-facing feature of
      both distribution flavours (ADR-0021's allow-list carries it with this reason); it is used only
      while PairQrScanActivity is in front and the image is never stored. `required=false` keeps the
      app installable on a device without a camera — the typed pairing form is the fallback.
    -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>

    <application
        android:name=".FamilyShieldApp"
        android:label="@string/app_name"
        android:icon="@drawable/ic_app"
        android:networkSecurityConfig="@xml/network_security_config">
        <!-- ADR-0021 / Play "Monitoring apps": required declaration, value child_monitoring. -->
        <meta-data android:name="isMonitoringTool" android:value="child_monitoring" />
        <service android:name=".services.AccessibilityMonitorService"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService"/>
            </intent-filter>
            <meta-data android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config"/>
        </service>

        <service android:name=".services.LocationService"
            android:foregroundServiceType="location" android:exported="false"/>
        <!-- Plan 1.4: the local DNS sinkhole / pause-internet tunnel (ADR-0015). -->
        <service android:name=".vpn.FilterVpnService"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <intent-filter>
                <action android:name="android.net.VpnService"/>
            </intent-filter>
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="parental-control web filter: local DNS sinkhole that enforces the family's web rules and pause-internet"/>
        </service>

        <service android:name=".services.FirebaseMessagingSvc" android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT"/>
            </intent-filter>
        </service>

        <!-- ADR-0010: Device Admin — enables remote lock and uninstall protection (behind the parent PIN). -->
        <receiver
            android:name=".security.GuardianAdminReceiver"
            android:label="@string/device_admin_label"
            android:description="@string/device_admin_description"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <receiver android:name=".receivers.BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
            </intent-filter>
        </receiver>

        <!-- Feature #8: install approval — detect new packages and alert the parent. -->
        <receiver android:name=".receivers.PackageAddedReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_ADDED"/>
                <data android:scheme="package"/>
            </intent-filter>
        </receiver>

        <!-- Feature #19: tamper — agent replaced (protected broadcast, system-delivered). -->
        <receiver android:name=".receivers.PackageReplacedReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
            </intent-filter>
        </receiver>

        <!-- Feature #14: child SOS quick-settings tile. -->
        <service
            android:name=".sos.SosTileService"
            android:exported="true"
            android:icon="@drawable/ic_sos"
            android:label="@string/sos_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE"/>
            </intent-filter>
        </service>

        <activity android:name=".sos.SosActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:turnScreenOn="true"/>

        <!-- ADR-0010: parent-PIN gate shown over the OS screens that remove protection. -->
        <activity android:name=".security.TamperGuardActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.Material.NoActionBar"/>

        <activity android:name=".setup.PairingActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Roadmap 3.2: camera-only QR reader. Not exported, and it returns text, not a pairing. -->
        <activity android:name=".setup.PairQrScanActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.NoActionBar"/>

        <!-- Issue #87: no showWhenLocked - a block screen must not cover the keyguard's PIN pad.
             Issue #175: the overlay must not share the screen with the app it covers. `resizeableActivity
             =false` makes the system launch it full-screen (leaving split screen) rather than into the
             other pane; `supportsPictureInPicture=false` means it never becomes a floating PiP window. -->
        <activity android:name=".enforcement.BlockActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:resizeableActivity="false"
            android:supportsPictureInPicture="false"
            android:turnScreenOn="true"/>

        <!-- Issue #87: no showWhenLocked here. Drawing over the keyguard hid the bouncer and locked the
             owner out of their own PIN; the activity defers to the keyguard instead (KeyguardPolicy).
             The ring screen above keeps showWhenLocked on purpose: it must be visible while locked.
             Issue #175: same multi-window flags as BlockActivity - the lock is a full-screen gate and
             must not sit in one pane of a split screen or as a PiP window. -->
        <activity android:name=".commands.LockActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:resizeableActivity="false"
            android:supportsPictureInPicture="false"
            android:turnScreenOn="true"/>
        <!-- Plan 1.7: the ring screen — over the lock screen, screen on, PIN to stop. -->
        <activity android:name=".commands.RingActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@android:style/Theme.Material.NoActionBar"/>
    </application>
</manifest>
