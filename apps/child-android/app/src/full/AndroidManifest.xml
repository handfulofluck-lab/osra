<?xml version="1.0" encoding="utf-8"?>
<!--
  Full (sideloaded) build only - ADR-0016. The Play build declares neither this permission nor the
  listener, so the store artefact physically cannot read notifications. `src/main` must stay free of
  both; FlavorManifestTest asserts that difference, because a flavor split regresses silently the
  moment someone "simplifies" a manifest.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE" />
    <!--
      ADR-0021: call-log and SMS reading are Full-only. Play's SMS/Call-Log policy has no exception for
      parental control ("family or device locator" is explicitly listed as an invalid use), so the Play
      artefact must not declare these at all.
    -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <!--
      ADR-0039 D5.5: the sideloaded build updates itself from osratech.com, so it is the one artefact
      that may declare this. Play's Device and Network Abuse policy forbids a store app installing code
      from outside Play, so src/main and src/play must never carry it; PlayManifestPolicy denies it by
      name and the merged-manifest gate runs on the Play merge.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application>
        <!-- ADR-0039 D5.4: the PackageInstaller session's status callback. Not exported: the system
             delivers the PendingIntent this app created, from this app's identity. -->
        <receiver android:name=".update.FullUpdateInstallReceiver" android:exported="false" />
        <service
            android:name=".services.NotificationCaptureService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
