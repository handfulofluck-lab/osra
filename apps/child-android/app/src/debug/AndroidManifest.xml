<?xml version="1.0" encoding="utf-8"?>
<!--
  Issue #170: a debug build is a test artefact, and a test runner must be able to replace it without
  the parent PIN (a credential that lives outside this repository since #164). `android:testOnly="true"`
  is what allows `adb install -r` without a signature match, and it also makes the OS treat the test
  admin as removable by `dpm` — but since #217 admin cleanup is the app's REMOVE PROTECTION (PARENT
  PIN), because `dpm remove-active-admin` strands Knox's admin record on Samsung.

  This overlay exists only for the `debug` build type: `src/full` and `src/main` never declare it, so
  neither Play nor Full **release** carries the flag — `testOnly` is exactly what makes an APK
  trivially replaceable, and the release builds keep the hard admin behind the app PIN. The merged
  manifests are pinned by PlayMergedManifestTest / FullMergedManifestTest.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:testOnly="true" />
</manifest>
