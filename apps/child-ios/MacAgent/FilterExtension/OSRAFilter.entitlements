<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for the Mac content filter (roadmap 5.9, step (iii), #988).

  `com.apple.developer.networking.networkextension` with `content-filter-provider` is what lets a
  NetworkExtension provider run at all. It is **granted by Apple** and must be present in the Developer ID
  provisioning profile used to sign this bundle; a signature without it loads nothing. That grant, and the
  profile, are the dependency Ahmed is confirming on #988 — nothing in CI can prove this file works.

  Deliberately absent: `com.apple.security.app-sandbox` (the daemon and the extension run outside the App
  Store, and the container-file handoff needs the path both processes can reach) and any team identifier
  (it comes from the signing identity, and a placeholder here would be a lie that codesign rejects).
-->
<plist version="1.0">
<dict>
    <key>com.apple.developer.networking.networkextension</key>
    <array>
        <string>content-filter-provider</string>
    </array>
</dict>
</plist>
