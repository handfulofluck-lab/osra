<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- agent.config.json intentionally unchanged (avoids orphaning paired PCs). -->
    <AssemblyName>OSRA.Agent</AssemblyName>
    <Product>OSRA</Product>
    <AssemblyTitle>OSRA Agent</AssemblyTitle>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.1</AssemblyVersion>
    <FileVersion>0.1.0.1</FileVersion>
    <OsraApiBase Condition="'$(OsraApiBase)' == ''">https://api.osratech.com</OsraApiBase>
  </PropertyGroup>
  <Target Name="GenerateBuildEndpoint" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_NormalizedOsraApiBase>$([System.String]::Copy('$(OsraApiBase)').Trim().TrimEnd('/'))</_NormalizedOsraApiBase>
      <_OsraApiBaseValid>$([System.Text.RegularExpressions.Regex]::IsMatch('$(_NormalizedOsraApiBase)', '^https://[A-Za-z0-9.-]+(?::[0-9]{1,5})?(?:/[A-Za-z0-9._~:/?#\[\]@!$&amp;()*+,;=-]*)?$'))</_OsraApiBaseValid>
      <_GeneratedBuildEndpointFile>$(IntermediateOutputPath)BuildEndpoint.g.cs</_GeneratedBuildEndpointFile>
      <_GeneratedBuildEndpointSource>// &lt;auto-generated /&gt;
namespace FamilyShield.Agent.Services%3B

internal static class BuildEndpoint
{
    public const string ApiBase = "$(_NormalizedOsraApiBase)"%3B
}
</_GeneratedBuildEndpointSource>
    </PropertyGroup>
    <Error Code="OSRA001"
           Condition="'$(_OsraApiBaseValid)' != 'True'"
           Text="OsraApiBase must be a valid https:// URL without whitespace or quotes (received '$(OsraApiBase)')." />
    <WriteLinesToFile File="$(_GeneratedBuildEndpointFile)"
                      Lines="$(_GeneratedBuildEndpointSource)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Remove="$(_GeneratedBuildEndpointFile)" />
      <Compile Include="$(_GeneratedBuildEndpointFile)" />
      <FileWrites Include="$(_GeneratedBuildEndpointFile)" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Hosting" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.6" />
    <PackageReference Include="System.Reactive" Version="6.0.1" />
    <PackageReference Include="Titanium.Web.Proxy" Version="3.2.3" />
  </ItemGroup>
  <ItemGroup>
    <!-- The xunit test project lives under tests/; keep it out of the shared library. -->
    <Compile Remove="tests/**/*.cs" />
    <EmbeddedResource Remove="tests/**/*" />
    <None Remove="tests/**/*" />
    <Compile Remove="src/**/*.cs" />
    <EmbeddedResource Remove="src/**/*" />
    <None Remove="src/**/*" />
    <!-- Emergency proxy reset shipped beside the exe (BUG-007). -->
    <None Include="reset-proxy.bat" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- Command dispatch mapping (Feature #11) is tested from the xunit project. -->
    <InternalsVisibleTo Include="FamilyShield.Agent.Tests" />
    <InternalsVisibleTo Include="OSRA" />
  </ItemGroup>
</Project>
