<?xml version="1.0" encoding="utf-8"?>
<!-- osra-security#8 F1 (Android 6-11): back up nothing. android:allowBackup="false" already turns backup off;
     this keeps a device maker's backup tool that ignores the flag from taking the data either. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
