# Production env, Frankfurt (#714). Copy to production.tfvars (gitignored) and fill the <...> values.
# This stack is long-lived in production: down.sh refuses it, and RDS/ALB carry deletion protection.

project     = "osra"
environment = "production"
region      = "eu-central-1"

assume_role_arn     = "arn:aws:iam::<prod-account-id>:role/<deploy-role-name>"
allowed_account_ids = ["<prod-account-id>"]

# Where base's state lives (must match backend/production-base.hcl).
state_bucket   = "osra-terraform-state-<prod-account-id>-eu-central-1"
state_region   = "eu-central-1"
base_state_key = "production/base/terraform.tfstate"

# base's ecr_repository_url output, tagged with the git sha the release is built from.
api_image = "<prod-account-id>.dkr.ecr.eu-central-1.amazonaws.com/osra-production/api:<git-sha>"

# API: 1 vCPU / 2 GiB per task, 2 to 6 tasks.
api_cpu       = 1024
api_memory    = 2048
api_min_count = 2
api_max_count = 6

# Network: one NAT gateway per AZ.
nat_gateway_count = 2
allowed_cidrs     = ["0.0.0.0/0"] # HTTPS only: base has a certificate, so port 80 just redirects

# PostgreSQL 16, Multi-AZ, 14 days of point-in-time restore.
db_instance_class        = "db.t4g.small"
db_multi_az              = true
db_allocated_storage     = 50
db_max_allocated_storage = 200
db_backup_retention_days = 14
db_deletion_protection   = true
db_skip_final_snapshot   = false
db_performance_insights  = true
db_backup_window         = "23:00-23:30"         # 03:00 UAE
db_maintenance_window    = "fri:00:00-fri:01:00" # Friday 04:00 UAE

# Cache: primary + replica in the other AZ, automatic failover, TLS (the API gets rediss://).
redis_node_type          = "cache.t4g.micro"
redis_num_nodes          = 2
redis_failover           = true
redis_transit_encryption = true

container_insights      = false # per-metric charge; alarms below cover the basics
alb_deletion_protection = true

waf_enabled     = true
waf_rate_limit  = 2000
waf_rate_action = "count" # switch to "block" after two weeks of real traffic

alarms_enabled = true
alarm_email           = "<alerts-address>"
alarm_email_secondary = "<second-alerts-address>" # required: a different inbox

# Required in production (the guard refuses empty or "*"). No browser page uses the API yet; this names the
# future parent web app's origin, so nothing else can call it with credentials from a browser.
cors_origin = "https://app.osratech.com"

# Only after put-secret-value has written the production FCM service account (README "Turning push on").
push_enabled = false

# Only after put-secret-value has written the APNs .p8 into <prefix>/apns-key-p8 (README "Turning push on").
# The two ids come from the Apple developer account; they are not secrets but never go in the repo.
apns_enabled = false
apns_key_id  = "<apns-key-id>"
apns_team_id = "<apple-team-id>"

# No secret value in state (#766 items 1, 3): RDS manages the master password, the API connects as osra_api,
# Redis requires AUTH, and the database URL verifies the server certificate. production-secrets.sh fills them.
secrets_out_of_band = true

# Item 13: settings the API needs for e-mail links and sending (SES setup is tracked in #766).
app_public_url = "https://app.osratech.com"
email_provider = ""
email_from     = ""

# VPC flow logs, WAF logs and PostgreSQL logs, each kept exactly 90 days (#766 item 2). ALB access logs stay off (the WebSocket ticket is in the query string).
audit_logs_enabled = true

# Database on its own KMS key, daily AWS Backup with a copy in the MANAGEMENT account in another EU region
# (org-audit output backup_copy_vault_arn), deleted after 90 days (#766 item 5). Turning the key on replaces
# the database instance: do it while it is empty.
db_customer_kms_key    = true
backup_copy_account_id = "<management-account-id>"
backup_copy_vault_arn  = "arn:aws:backup:eu-west-1:<management-account-id>:backup-vault:osra-production-copy"
