{
  "$comment": "OSRA design tokens (ADR-0037). The one source for colour, shape and type on every platform. Each platform generates or hand-copies its theme from this file; a value that differs from it is a bug. Light is 'Calm', dark is 'Control room'.",
  "version": 1,
  "color": {
    "page":            { "light": "#F1F5F4", "dark": "#0E1417", "use": "Screen background" },
    "card":            { "light": "#FFFFFF", "dark": "#172026", "use": "Cards, lists, sheets, bottom bar" },
    "cardBorder":      { "light": "transparent", "dark": "#2B3840", "use": "1 px card outline (dark only)" },
    "raised":          { "light": "#FFFFFF", "dark": "#1E2A31", "use": "Secondary buttons, steppers" },
    "line":            { "light": "#E6ECEB", "dark": "#2B3840", "use": "Dividers inside a card" },
    "border":          { "light": "#C9D6D3", "dark": "#3A4A53", "use": "Outline of secondary buttons and inputs" },
    "ink":             { "light": "#12211F", "dark": "#E9EFF1", "use": "Primary text" },
    "muted":           { "light": "#4D5E5A", "dark": "#A7B6BD", "use": "Secondary text" },
    "primary":         { "light": "#0B5D57", "dark": "#7DB4FF", "use": "Primary button, switch on, links, today's bar" },
    "onPrimary":       { "light": "#FFFFFF", "dark": "#0E1417", "use": "Text on primary" },
    "tint":            { "light": "#EAF2F0", "dark": "#1E2A31", "use": "Selected row, app icon tile" },
    "ok":              { "light": "#0B5D57", "dark": "#86D4BE", "use": "'Protected', 'Active on the phone'" },
    "warn":            { "light": "#8A4B00", "dark": "#FFB454", "use": "'Needs attention' text, limit line on charts" },
    "warnContainer":   { "light": "#FFF0D4", "dark": "#3A2A10", "use": "Needs-attention box" },
    "onWarnContainer": { "light": "#5E3300", "dark": "#FFD9A0", "use": "Text in the needs-attention box" },
    "warnSolid":       { "light": "#8A4B00", "dark": "#FFB454", "use": "Fix button" },
    "onWarnSolid":     { "light": "#FFFFFF", "dark": "#0E1417", "use": "Text on the Fix button" },
    "danger":          { "light": "#A3242B", "dark": "#FF9A8C", "use": "Safety concern, destructive action" },
    "onDanger":        { "light": "#FFFFFF", "dark": "#0E1417", "use": "Text on danger" },
    "track":           { "light": "#E2EAE8", "dark": "#2B3840", "use": "Progress track, day strip background" },
    "switchOff":       { "light": "#7D8C89", "dark": "#6A7C86", "use": "Switch track when off" },
    "switchKnob":      { "light": "#FFFFFF", "dark": "#0E1417", "use": "Switch knob" },
    "barIdle":         { "light": "#B9CBC7", "dark": "#4E6573", "use": "Chart bars that are not today or not selected" },
    "bandBedtime":     { "light": "#C7D0E2", "dark": "#2A3550", "use": "Bedtime band on the day strip" },
    "bandSchool":      { "light": "#DCE4CC", "dark": "#2F3B33", "use": "School time and other schedule bands" },
    "bandInk":         { "light": "#2C3A37", "dark": "#C9D4D9", "use": "Label inside a band" },
    "scrim":           { "light": "#5D6866", "dark": "#05080A", "use": "Behind a sheet" },
    "mapGround":       { "light": "#DDE7E4", "dark": "#121B20", "use": "Map placeholder ground (real map tiles follow the theme)" }
  },
  "usageCategory": {
    "video":    { "light": "#0B5D57", "dark": "#7DB4FF" },
    "games":    { "light": "#C96A12", "dark": "#FFB454" },
    "social":   { "light": "#7A3E8E", "dark": "#E6A8D0" },
    "learning": { "light": "#1F4E9A", "dark": "#B7D48A" },
    "other":    { "light": "#6B7775", "dark": "#8A9BA3" }
  },
  "childColor": {
    "$comment": "Assigned in order when a child is added; the parent can change it. Used for the avatar and the map pin only, never to carry meaning alone.",
    "light": ["#0B5D57", "#7A3E8E", "#1F4E9A", "#A3242B", "#8A4B00", "#3D5A2A"],
    "dark":  ["#7DB4FF", "#E6A8D0", "#B7D48A", "#FF9A8C", "#FFB454", "#86D4BE"],
    "onChild": { "light": "#FFFFFF", "dark": "#0E1417" }
  },
  "radius": {
    "card":    { "light": 18, "dark": 12 },
    "control": { "light": 12, "dark": 8 },
    "sheet":   { "light": 26, "dark": 16 },
    "bar":     { "light": 4,  "dark": 4 }
  },
  "space": { "xxs": 2, "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24, "xxl": 32 },
  "size": { "touchTargetMin": 44, "primaryButtonHeight": 52, "actionButtonHeight": 44, "bottomBarHeight": 64, "avatar": 40 },
  "type": {
    "family": { "latin": "IBM Plex Sans", "arabic": "IBM Plex Sans Arabic" },
    "numeric": { "light": "IBM Plex Sans (tabular figures)", "dark": "IBM Plex Mono 600", "use": "Clock times and figures that stand alone. Numbers inside a sentence keep the text face." },
    "scale": {
      "screenTitle": { "size": 26, "line": 32, "weight": 700 },
      "pageTitle":   { "size": 22, "line": 28, "weight": 700 },
      "status":      { "size": 17, "line": 23, "weight": 400 },
      "cardTitle":   { "size": 17, "line": 22, "weight": 700 },
      "body":        { "size": 15, "line": 20, "weight": 400 },
      "rowTitle":    { "size": 15, "line": 20, "weight": 600 },
      "secondary":   { "size": 13, "line": 18, "weight": 400 },
      "caption":     { "size": 11, "line": 14, "weight": 400 },
      "bigNumber":   { "size": 48, "line": 52, "weight": 700 }
    }
  }
}
