generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Family {
  id        String   @id @default(uuid())
  name      String
  region    String
  /// ADR-0017/ADR-0020: IANA zone that decides when the family's digest is "evening". Backfilled to UTC
  /// because `region` is a market (US/EU/UK/OTHER), not a country.
  timezone  String   @default("UTC")
  /// ADR-0020: where `timezone` came from - `default` (never set), `device` (filled from a parent's
  /// device at registration/login) or `parent` (chosen explicitly and never overwritten).
  timezoneSource String @default("default")
  createdAt DateTime @default(now())
  parents   Parent[]
  children  Child[]
}

/// ADR-0017: one row per (family, kind, period) that was sent, so a restart, a duplicate scheduler or
/// a DST-repeated hour cannot send twice. `period` is the local date (daily) or ISO week (weekly).
model DigestSend {
  id       String   @id @default(uuid())
  familyId String
  kind     String
  period   String
  sentAt   DateTime @default(now())
  // Terminal failure (ADR-0024): set when the provider refused permanently (e.g. an address it will
  // never accept). The row stays so the unique key blocks retries for this period; null while the
  // claim is live or was delivered.
  failedReason String?

  @@unique([familyId, kind, period])
  @@index([familyId])
}

model Parent {
  id           String          @id @default(uuid())
  familyId     String
  email        String          @unique
  passwordHash String
  displayName  String
  role         String          @default("owner")
  // Free-text permission tags granted via FamilyInvite accept (Feature #13, e.g. "location", "controls").
  permissions  String[]        @default([])
  // ADR-0023 / #183: `mfaEnabled` is the account's second-factor policy; `mfaSecret` is the bound
  // factor. A recovery clears only the secret, so `mfaEnabled && mfaSecret == null` means "MFA
  // required, no authenticator bound": `/login` refuses it with 401 mfa_reenroll_required.
  mfaEnabled   Boolean         @default(false)
  mfaSecret    String?
  /// ADR-0032 / roadmap 2.7: the parent's sessions version, the durable record behind
  /// `auth:session-version:<parentId>`. Every revocation of this parent's sessions increments it;
  /// Redis is a cache of this column and is rebuilt from it on a miss. `default(0)` means "nothing
  /// revoked", so a parent that never revoked needs no row change and no migration backfill.
  sessionVersion Int           @default(0)
  createdAt    DateTime        @default(now())
  family       Family          @relation(fields: [familyId], references: [id])
  consents     ConsentRecord[]
  pushTokens   ParentPushToken[]
  mfaRecoveryCodes ParentMfaRecoveryCode[]
  mfaResetRequests MfaResetRequest[]
  accountDeletionTokens AccountDeletionToken[]
}

/// ADR-0032 / roadmap 2.7: a single-logout revocation, the durable record behind
/// `revoked:token:<jti>`. One row per ended session, written in the same request as that key, so a
/// restarted or evicted Redis cannot make a logged-out access token work again.
///
/// `parentId` is denormalised with no FK, like `DigestSend.familyId`: the row is the record of a
/// revocation and is deleted only by its own expiry. `expiresAt` is the access token's own end (the
/// 8-day key TTL), so the nightly prune (`src/jobs/revokedTokenPrune.ts`) deletes only rows whose
/// token has already expired. No `usedAt`/`reason`: a revocation has no lifecycle beyond "until the
/// token would have expired".
model RevokedToken {
  jti       String   @id
  parentId  String
  expiresAt DateTime

  @@index([parentId])
}

/// ADR-0023 Option A: one-time MFA recovery codes. Only the SHA-256 hash of the normalised code is
/// stored; the plaintext exists in the issuing response and nowhere else. A row with `usedAt` set is
/// kept as the record that the batch was spent; recovery deletes the sibling rows.
/// #442 PR 3: the single-use link `POST /v1/account/deletion-request` mails, which opens the web page that
/// deletes the account (Play's "delete from a web link" requirement). `tokenHash` is the SHA-256 of the
/// 32-byte token; the plaintext exists only in the email. 30 minutes (`expiresAt`), and `usedAt` is set
/// by the one conditional update that spends it, so two submits cannot both pass. A new request
/// deletes the parent's earlier rows, so one parent has at most one live link. The account deletion
/// itself deletes every row of the deleted parents (`FAMILY_SCOPED_DELETES`, `PARENT_SCOPED_DELETES`).
model AccountDeletionToken {
  id        String    @id @default(uuid())
  parentId  String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  parent    Parent    @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@index([parentId])
}

model ParentMfaRecoveryCode {
  id        String    @id @default(uuid())
  parentId  String
  codeHash  String
  createdAt DateTime  @default(now())
  usedAt    DateTime?
  parent    Parent    @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@index([parentId, usedAt])
}

/// ADR-0031: one row per MFA-reset request, the audit record and the state machine.
///
/// `state` is the ADR's vocabulary: `requested` → `mailbox_confirmed` → `witness_passed` →
/// `completed`, with `cancelled_by_signin` / `cancelled_by_link` / `cancelled_by_parent` / `expired` /
/// `too_many_attempts` as terminal alternatives. `no_witness` is the request-time refusal (claim 7)
/// and is deliberately never written: nothing is stored for it. `cancelledReason` repeats which of the
/// three paths closed the request, because that is what an operator looks for first.
///
/// No IP address, user agent or free text is stored, timestamps are filled once, and the outcome is
/// written once (decision 8). `codeHash` is the SHA-256 of the 8-digit device code; the plaintext only
/// ever exists in the `show_reset_code` command payload (claim 6). Rows are deleted 12 months after
/// `outcomeAt` by src/jobs/mfaResetExpiry.ts.
model MfaResetRequest {
  id                 String    @id @default(uuid())
  parentId           String
  /// Denormalised from Parent for the audit read; no FK, like DigestSend.familyId.
  familyId           String
  state              String    @default("requested")
  createdAt          DateTime  @default(now())
  emailConfirmedAt   DateTime?
  /// `device` | `parent`; for a device witness `witnessRef` stays null because the one code is shown
  /// on every paired device, so no single device can be named as the witness.
  witnessKind        String?
  witnessRef         String?
  witnessAt          DateTime?
  /// `witnessAt` + 72 h. `complete` is refused before this instant (claim 1d).
  windowEndsAt       DateTime?
  failedCodeAttempts Int       @default(0)
  codeHash           String?
  codeExpiresAt      DateTime?
  completedAt        DateTime?
  cancelledReason    String?
  outcomeAt          DateTime?
  parent             Parent    @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@index([parentId, state])
  @@index([state, emailConfirmedAt])
  @@index([state, createdAt])
  @@index([outcomeAt])
}

/// A parent device registered for push delivery of alerts (Phase 2a). One row per app install;
/// tokens are pruned when FCM/APNs report them unregistered. `platform` is "android" | "ios" | "web".
model ParentPushToken {
  id         String   @id @default(uuid())
  parentId   String
  token      String   @unique
  platform   String
  appVersion String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  parent     Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@index([parentId])
}

model Child {
  id          String          @id @default(uuid())
  familyId    String
  displayName String
  birthYear   Int
  avatarUrl   String?
  createdAt   DateTime        @default(now())
  family      Family          @relation(fields: [familyId], references: [id])
  devices     Device[]
  ruleSet     RuleSet?
  locations   LocationPing[]
  geofences   Geofence[]
  alerts      Alert[]
  consents    ConsentRecord[]
  pairingDecisions PairingDecision[]
}

/// Plan 2.7 (the parent approves each new device): who allowed or refused which phone. `model` is the
/// device-supplied name after the server's cleaning (control and bidi characters stripped, 64 characters
/// at most). Child data: the GDPR erasure deletes it with the child, and the family export includes it.
model PairingDecision {
  id        String   @id @default(uuid())
  familyId  String
  childId   String
  parentId  String
  claimId   String
  decision  String
  platform  String
  model     String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  child     Child    @relation(fields: [childId], references: [id])

  @@index([familyId, createdAt])
  @@index([childId])
}

model Device {
  id         String         @id @default(uuid())
  childId    String
  platform   String
  model      String
  osVersion  String
  /// online | offline | locked | sos (mirrors DeviceStatus in packages/shared-types). Writers set
  /// `online` on pair/claim, telemetry and location ping; the silence job sets `offline`. Nothing
  /// writes `active` — it was the job's stale assumption and is fixed in src/jobs/deviceSilence.ts.
  status     String         @default("offline")
  batteryPct Int            @default(0)
  lastSeen   DateTime       @default(now())
  pushToken  String?
  // Per-device internal HMAC secret (minted at pair/claim; handoff item 5).
  internalSecret String?
  /// Roadmap 3.4: when the agent last replaced its installed-launchable-app list, and the report
  /// contract version it used. Null means the device has never reported (the parent picker says so).
  appsReportedAt DateTime?    @db.Timestamptz(3)
  appsVersion    Int?
  /// Issue #221: the location grant an Android agent last reported in its telemetry upload —
  /// `background` | `while_in_use` | `none` (src/lib/locationGrant.ts). Null until the agent has
  /// reported once, which must be treated as "unknown", never as "missing": an older agent that
  /// does not send the field would otherwise have every `locate_now` failed at creation.
  locationGrant String?
  /// Issue #221 D1 follow-up: when the agent reported that grant. The command route refuses a
  /// `locate_now` only on a report younger than one telemetry period (lib/locationGrant.ts); an
  /// older or undated report is "unknown" and the command is queued so the phone can answer it.
  locationGrantReportedAt DateTime? @db.Timestamptz(3)
  child      Child          @relation(fields: [childId], references: [id])
  locations  LocationPing[]
  alerts     Alert[]
  commands   DeviceCommand[]
  apps       DeviceApp[]
}

/// Roadmap 3.4: the launchable apps a child device reported, so the parent can build an AppRule from
/// a real label instead of typing a package id. This is an inventory, not usage: one row per
/// (device, package) replaced on every report, with no minutes, launches or screen-on data.
/// `label` is the launcher label (capped at 100 characters); `isSystem` is the OS system flag.
model DeviceApp {
  id        String   @id @default(uuid())
  deviceId  String
  packageId String
  label     String
  isSystem  Boolean  @default(false)
  /// Issue #199 item 5: computed on the phone with `EssentialPackages.isEssential(packageId,
  /// PackageFacts)`. **Nullable on purpose**: null is "this phone has not reported it", so an old row,
  /// an older Play agent or the iOS agent never claims "not essential" or "always allowed". Display
  /// only — the server does not enforce with it, and no parent request writes it.
  essential Boolean?
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, packageId])
  @@index([deviceId])
}

/// Durable device command queue (Phase 2b, ADR-0012). Source of truth for "did the lock reach the
/// phone": pending → delivered (claimed by the device's drain) → acked | failed (device ack), or
/// expired (never claimed before `expiresAt`). Redis pub/sub remains the wake-up signal only.
model DeviceCommand {
  id          String    @id @default(uuid())
  deviceId    String
  type        String
  payload     Json      @default("{}")
  status      String    @default("pending")
  requestedBy String?
  attempts    Int       @default(0)
  // Issue #53: timestamptz so raw SQL comparisons cannot depend on the DB session time zone.
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt   DateTime  @db.Timestamptz(3)
  deliveredAt DateTime? @db.Timestamptz(3)
  ackedAt     DateTime? @db.Timestamptz(3)
  result      Json?
  device      Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, status])
  @@index([deviceId, createdAt])
}

model RuleSet {
  id                  String   @id @default(uuid())
  childId             String   @unique
  dailyLimitMinutes   Int      @default(180)
  weekendLimitMinutes Int      @default(300)
  bedtimeStart        String   @default("21:00")
  bedtimeEnd          String   @default("07:00")
  schoolHoursStart    String   @default("08:00")
  schoolHoursEnd      String   @default("15:00")
  schoolDays          Int[]    @default([1,2,3,4,5])
  blockedCategories   String[]
  allowedDomains      String[]
  blockedDomains      String[]
  safeSearchEnforced  Boolean  @default(true)
  youtubeRestrictedMode String @default("strict")
  alwaysAllowedApps   String[] @default([])
  bonusMinutesToday   Int      @default(0)
  socialMonitoring    Json     @default("{}")
  contactAllowlist    String[] @default([])
  appRules            Json     @default("[]")
  routines            Json     @default("[]")
  updatedAt           DateTime @updatedAt
  child               Child    @relation(fields: [childId], references: [id])
}

model ActivityEvent {
  id        String   @id @default(uuid())
  childId   String
  deviceId  String?
  ts        DateTime @default(now())
  type      String
  payload   Json     @default("{}")
  @@index([childId, ts])
}

/// Phase 2c (ADR-0013): per-child, per-device, per-app daily minutes. Written incrementally at
/// ingestion and reconciled from ActivityEvent by the nightly rollup, so the weekly report does not
/// depend on Redis (`usage:child:*` is a cache of today only) and survives raw-event retention.
/// `app = "*"` is the device-reported total for the day (telemetry `totalMinutes`).
model AppUsageDaily {
  id        String   @id @default(uuid())
  childId   String
  deviceId  String   @default("")
  day       DateTime @db.Date
  app       String
  minutes   Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  @@unique([childId, deviceId, day, app])
  @@index([childId, day])
}

/// Phase 2c (ADR-0013): one row per URL visit (from ActivityEvent type "url"), queryable as browsing
/// history without scanning the JSON event log. Subject to the raw-data retention window.
model WebVisit {
  id       String   @id @default(uuid())
  childId  String
  deviceId String?
  ts       DateTime @default(now()) @db.Timestamptz(3)
  domain   String
  url      String   @default("")
  blocked  Boolean  @default(false)
  category String   @default("")
  @@index([childId, ts])
}

model SocialEvent {
  id            String   @id @default(uuid())
  childId       String
  app           String
  contact       String   @default("")
  severity      String   @default("warning")
  previewCipher String   @default("")
  concernTypes  String[] @default([])
  createdAt     DateTime @default(now())
  @@index([childId, createdAt])
}

model FamilyInvite {
  id          String   @id @default(uuid())
  familyId    String
  email       String
  role        String   @default("co-parent")
  permissions String[] @default([])
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  @@index([familyId])
}

model DigestPrefs {
  familyId    String   @id
  dailyEmail  Boolean  @default(true)
  weeklyEmail Boolean  @default(true)
  pushEnabled Boolean  @default(true)
  emails      String[] @default([])
}

/// Roadmap 2.7 (osra-security#2): an address that is not a parent of the family has to confirm before a
/// digest is sent to it, so a family's recipient list cannot turn the sending domain into a relay.
///
/// One row per (family, address). `confirmedAt` is the durable proof that the address asked for the
/// digest; `tokenHash` is the SHA-256 of the single-use 24-hour link token and `tokenExpiresAt` its
/// deadline. Confirming clears both, so the link is spent. A parent's own address needs no row: it is
/// trusted as that account's address (see lib/digestRecipients.ts).
model DigestRecipient {
  id             String    @id @default(uuid())
  familyId       String
  email          String
  confirmedAt    DateTime?
  tokenHash      String?   @unique
  tokenExpiresAt DateTime?
  createdAt      DateTime  @default(now())

  @@unique([familyId, email])
  @@index([familyId])
}

model InstallRequest {
  id        String   @id @default(uuid())
  childId   String
  packageId String
  appName   String   @default("")
  status    String   @default("pending")
  createdAt DateTime @default(now())
  @@index([childId])
}

model LocationPing {
  id        String   @id @default(uuid())
  childId   String
  deviceId  String
  lat       Float
  lng       Float
  accuracyM Float
  timestamp DateTime @default(now())
  child     Child    @relation(fields: [childId], references: [id])
  device    Device   @relation(fields: [deviceId], references: [id])
  @@index([childId, timestamp])
}

model Geofence {
  id            String  @id @default(uuid())
  childId       String
  label         String
  lat           Float
  lng           Float
  radiusM       Int
  notifyOnEnter Boolean @default(true)
  notifyOnExit  Boolean @default(true)
  routineId     String?
  child         Child   @relation(fields: [childId], references: [id])
}

model Alert {
  id           String   @id @default(uuid())
  childId      String
  deviceId     String?
  severity     String
  category     String
  title        String
  body         String
  metadata     Json     @default("{}")
  /// Idempotency key supplied by the producer (issue #225). Null for alerts without one.
  /// The partial unique index lives in migration 0019 because Prisma cannot express it.
  dedupeKey    String?
  /// Repeated attempts aggregated into this row (issue #227). 1 for every ordinary alert; a guard
  /// alert's window updates it in place. Additive, defaulted, so no backfill and no producer change.
  attemptCount Int      @default(1)
  createdAt    DateTime @default(now())
  acknowledged Boolean  @default(false)
  child        Child    @relation(fields: [childId], references: [id])
  device       Device?  @relation(fields: [deviceId], references: [id])
  @@index([childId, createdAt])
}

model ConsentRecord {
  id                String   @id @default(uuid())
  childId           String
  parentId          String
  method            String
  jurisdiction      String
  grantedAt         DateTime @default(now())
  expiresAt         DateTime?
  revokedAt         DateTime?
  thirdPartySharing Boolean  @default(false)
  child             Child    @relation(fields: [childId], references: [id])
  parent            Parent   @relation(fields: [parentId], references: [id])

  @@index([childId, revokedAt])
}
