{
  "name": "@familyshield/api",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:e2e": "node --experimental-websocket scripts/e2e.mjs",
    "db:migrate": "prisma migrate deploy && prisma generate",
    "postinstall": "prisma generate",
    "db:seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@familyshield/crypto": "workspace:*",
    "@familyshield/shared-types": "workspace:*",
    "@fastify/cors": "^9.0.0",
    "@fastify/jwt": "^8.0.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/websocket": "^10.0.0",
    "@prisma/client": "^5.14.0",
    "argon2": "^0.40.0",
    "fastify": "^4.27.0",
    "ioredis": "^5.4.0",
    "pino": "^9.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "prisma": "^5.14.0",
    "tsx": "^4.10.0",
    "vitest": "^1.6.0",
    "typescript": "^5.4.0"
  }
}
