DATABASE_URL=postgres://familyshield:devpass@localhost:5432/familyshield
REDIS_URL=redis://localhost:6379
AI_ENGINE_URL=http://localhost:8000
JWT_SECRET=dev-secret-change-me
INTERNAL_HMAC_SECRET=internal-hmac-dev-secret
# ADR-0014 signing v2: legacy body-only device signatures are refused unless this is 1 — set 1 only for the
# length of a rollout whose agents still sign v1 (the probe then reports target J7);
# services allowed to sign with INTERNAL_HMAC_SECRET (comma-separated X-FamilyShield-Caller values)
INTERNAL_SIGNING_ALLOW_V1=0
INTERNAL_SERVICE_CALLERS=ai-engine
PORT=3000
VAULT_KEY=<base64 of 32 random bytes>
APP_PUBLIC_URL=http://localhost:3000
# Parent notifications (Phase 2a) — leave unset to disable
# FCM_SERVICE_ACCOUNT_JSON=<base64 service-account json>
# APNS_KEY_P8=<base64 .p8>  APNS_KEY_ID=  APNS_TEAM_ID=  APNS_BUNDLE_ID=  APNS_ENV=sandbox
# RESEND_API_KEY=  EMAIL_FROM="OSRA <no-reply@example.com>"
PUSH_MIN_SEVERITY=info
DIGEST_HOUR_UTC=18
# Phase 2c usage rollup + retention (ADR-0013): nightly hour (UTC) and the retention windows in days
ROLLUP_HOUR_UTC=2
RETENTION_DAYS=90
ROLLUP_RETENTION_DAYS=365
JOBS_ENABLED=1
