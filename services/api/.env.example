DATABASE_URL=postgres://familyshield:devpass@localhost:5432/familyshield
REDIS_URL=redis://localhost:6379
AI_ENGINE_URL=http://localhost:8000
JWT_SECRET=dev-secret-change-me
INTERNAL_HMAC_SECRET=internal-hmac-dev-secret
# ADR-0014 signing v2: legacy body-only device signatures are refused unless this is 1 — set 1 only for the
# length of a rollout whose agents still sign v1 (the probe then reports target J7);
# services allowed to sign with INTERNAL_HMAC_SECRET (comma-separated X-FamilyShield-Caller values)
INTERNAL_SIGNING_ALLOW_V1=0
INTERNAL_SERVICE_CALLERS=ai-engine
PORT=3000
# Proxy hops in front of the API, so rate limits key on the client address from X-Forwarded-For (plan 2.7).
# 1 behind the AWS ALB (infra/terraform/env/ecs.tf). A hop count only: `true` is refused at boot. Leave
# unset when the API is reached directly (local development), or a caller could pick its own address.
# TRUST_PROXY=1
VAULT_KEY=<base64 of 32 random bytes>
APP_PUBLIC_URL=http://localhost:3000
# Parent notifications (Phase 2a) — leave unset to disable
# FCM_SERVICE_ACCOUNT_JSON=<base64 service-account json>
# APNS_KEY_P8=<base64 .p8>  APNS_KEY_ID=  APNS_TEAM_ID=  APNS_BUNDLE_ID=  APNS_ENV=sandbox
# RESEND_API_KEY=  EMAIL_FROM="OSRA <no-reply@example.com>"
PUSH_MIN_SEVERITY=info
# Digest hour (ADR-0017/0024): the family's **local** hour, not UTC — the scheduler compares it with
# each family's `Family.timezone` (default 18:00 local). DIGEST_HOUR_UTC is the pre-ADR-0017 name: still
# read, but it too means the local hour; set DIGEST_HOUR.
DIGEST_HOUR=18
# Phase 2c usage rollup + retention (ADR-0013): nightly hour (UTC) and the retention windows in days.
# LOCATION_RETENTION_DAYS (ADR-0028 decision 5) is separate from RETENTION_DAYS: 30 by default, floor 7,
# and never above RETENTION_DAYS. A bad value falls back to min(30, RETENTION_DAYS).
ROLLUP_HOUR_UTC=2
# Device-silence watch: an `online` device unseen for this many minutes gets a device_silent tamper
# alert. Safe minimum 30 = 2 x the agent's 15-minute telemetry cadence (issue #166); a tighter value
# is clamped to 30 at boot with a warning. DEVICE_SILENT_ALLOW_TIGHT=1 keeps a value down to 5 and is
# TEST ONLY (the TR-22 hardware row) — see docs/TESTING.md §5f.
DEVICE_SILENT_MINUTES=30
RETENTION_DAYS=90
LOCATION_RETENTION_DAYS=30
ROLLUP_RETENTION_DAYS=365
JOBS_ENABLED=1
